<?xml version="1.0" encoding="utf-8"?>
<!--
  Zebra Enterprise Home Screen configuration
  Compatible with the EHS 8.0 configuration structure (latest release: EHS 8.0.1).

  KIOSK APPLICATION:
    Enterprise Browser package for EB 3.3 and later:
    com.zebra.mdna.enterprisebrowser

  IMPORTANT:
    EHS Kiosk Mode permits only the app in the <kiosk> section to be used.
    Apps in <applications> are retained for User Mode and are hidden while
    <kiosk_mode_enabled> is set to 1.
-->
<config>
    <kiosk>
        <!-- Activity is optional; EHS launches the package's default activity. -->
        <application label="Enterprise Browser"
                     package="com.zebra.mdna.enterprisebrowser"
                     activity=""/>
    </kiosk>

    <applications>
        <!-- These apps are available only after Kiosk Mode is disabled. -->
        <application label="Enterprise Browser"
                     package="com.zebra.mdna.enterprisebrowser"
                     activity=""/>

        <!-- Optional Zebra sample application. Remove if not required. -->
        <application label="DataWedge Demo"
                     package="com.symbol.datawedge"
                     activity="com.symbol.datawedge.DWDemoActivity"/>

        <!-- Optional additional application. Remove if Chrome is not required. -->
        <application label="Chrome"
                     package="com.android.chrome"
                     activity=""/>

        <!-- Add further applications using this format:
        <application label="Your App"
                     package="com.company.application"
                     activity="com.company.application.MainActivity"/>
        -->
    </applications>

    <!-- Keep the Tools menu empty so no extra app is exposed through EHS tools. -->
    <tools>
    </tools>

    <!-- Set the administrator password from EHS Admin Mode; do not type a
         plain-text password into this element. EHS stores an encrypted value. -->
    <passwords>
        <admin></admin>
    </passwords>

    <preferences>
        <title>Enterprise Browser Kiosk</title>
        <icon_label_background_color>#00FFFFFF</icon_label_background_color>
        <icon_label_text_color>#FFFFFFFF</icon_label_text_color>
        <orientation></orientation>

        <!-- Kiosk Mode launches Enterprise Browser and blocks HOME/BACK exit. -->
        <kiosk_mode_enabled>1</kiosk_mode_enabled>

        <!-- Auto-launch is not needed when Kiosk Mode is enabled. -->
        <auto_launch_enable>0</auto_launch_enable>
        <service_auto_launch_enable>0</service_auto_launch_enable>

        <wallpaper></wallpaper>
        <keyguard_camera_disabled>1</keyguard_camera_disabled>
        <keyguard_search_disabled>1</keyguard_search_disabled>

        <!-- Lab-safe setting: ADB remains available so kiosk mode can be
             disabled by pushing a revised XML. Change to 1 for production only
             after testing and establishing another supported recovery method. -->
        <usb_debugging_disabled>0</usb_debugging_disabled>

        <system_settings_restricted>1</system_settings_restricted>
        <recent_apps_button_disabled>1</recent_apps_button_disabled>
        <recent_apps_access_disabled>1</recent_apps_access_disabled>

        <wireless_info>
            <show_ip_address>0</show_ip_address>
            <show_mac_address>0</show_mac_address>
            <show_bssid>0</show_bssid>
            <show_ssid>0</show_ssid>
            <show_scan_result>0</show_scan_result>
        </wireless_info>

        <screen_blanking>
            <blanking_enabled>0</blanking_enabled>
            <speed_threshold>10</speed_threshold>
            <blanking_mode>1</blanking_mode>
        </screen_blanking>
    </preferences>
</config>
